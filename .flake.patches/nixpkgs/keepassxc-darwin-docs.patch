From 38f74c6acc853a6cbaa662d53345ea682455ea29 Mon Sep 17 00:00:00 2001
From: Fernando Rodrigues <alpha@sigmasquadron.net>
Date: Sat, 7 Nov 2026 00:31:06 +1100
Subject: [PATCH] keepassxc: fix withKeePassDocs = false

If withKeePassDocs is set to false, the derivation would still split the doc and man outputs and would try to copy non-existent files there, failing the build. Additionally, the split outputs need not exist on Darwin, as the documentation is built into the app bundle.

This patch fixes both issues.

Signed-off-by: Fernando Rodrigues <alpha@sigmasquadron.net>
---
 pkgs/by-name/ke/keepassxc/package.nix | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/pkgs/by-name/ke/keepassxc/package.nix b/pkgs/by-name/ke/keepassxc/package.nix
index 119ea01d9c8d30ace4114bc0bc8b0d21fada1d22..06daaf5544bb6012541db1d5cedcafe024bca44e 100644
--- a/pkgs/by-name/ke/keepassxc/package.nix
+++ b/pkgs/by-name/ke/keepassxc/package.nix
@@ -48,10 +48,13 @@ stdenv.mkDerivation (finalAttrs: {
   };
 
   __structuredAttrs = true;
+
   outputs = [
     "out"
-    "doc"
+  ]
+  ++ lib.optionals (withKeePassDocs && stdenv.hostPlatform.isLinux) [
     "man"
+    "doc"
   ];
 
   env = lib.optionalAttrs stdenv.cc.isClang {
@@ -135,10 +138,10 @@ stdenv.mkDerivation (finalAttrs: {
   '';
 
   postInstall = lib.concatLines [
-    ''
+    (lib.optionalString (withKeePassDocs && stdenv.hostPlatform.isLinux) ''
       mkdir -p $doc/share/doc
       mv $out/share/keepassxc/docs/ $doc/share/doc/keepassxc
-    ''
+    '')
 
     (lib.optionalString stdenv.hostPlatform.isDarwin ''
       mkdir -p "$out/bin"
