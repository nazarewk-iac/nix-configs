{
  inputs,
  pkgs,
  config,
  ...
}:
let
  # The aspects this repository's own shell turns on. An aspect has no `enable` option:
  # inclusion in this list is the switch.
  #
  # `mcp` and `mcp-pretty-print` stay out: `nix` and `jj` include `mcp`, and
  # `mcp-basic-memory` includes `mcp-pretty-print`. den collapses the diamond, so one shell
  # holds one gateway.
  #
  # `jj-fork` stays out. This repository is the public upstream, not a fork, so it carries
  # no private remote and no denied pattern. A downstream fork adds that aspect in its own
  # tree.
  aspects = [
    "gh"
    "nix"
    "jj"
    "zellij"
    "mcp-snoop"
    "mcp-basic-memory"
    "opencode"
  ];

  # The Pi coding agent, configured from this repository's own files. `mkCodingAgent` returns a
  # wrapper that always passes --append-system-prompt/--extension, so the shell's `pi` carries the
  # repo config with no ~/.pi drift. `models` installs to the agent dir on first run.
  # `inputs.pi` is the flake-CLI input; devenv gets its inputs from devenv.yaml, which does not
  # declare `pi`. Reach the SAME pin through `nix-configs` (this repo's own flake output), so there
  # is one `pi.nix` pin in the tree, not two.
  pi = inputs.nix-configs.inputs.pi;

  ext = pkgs.callPackage ./packages/pi-coding-agent-extensions { };

  # The pinned ClankTalk runtime. The OpenCode slot takes it as an option because a devenv `pkgs`
  # has no repository overlay; the Pi launcher takes the same package.
  clankTalk = inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.clank-talk;

  # The system prompt for every extension's agent: the repository working style plus the model
  # catalog, joined into ONE file because `rules` takes a single path and pi has ONE
  # `--append-system-prompt`. The catalog is what lets the orchestrator pick a model from intent
  # and cost instead of a fixed tier; it is rendered from data/llm.nix, so it never drifts.
  llm = import ./lib/llm.nix { inherit (inputs.nixpkgs) lib; };
  piRulesText = ''
    ${builtins.readFile ./data/pi/AGENTS.md}

    ## Model catalog (for the orchestrator)

    What each served model id is and what a switch costs. `ctx` is the served context in tokens — a
    hard filter, not a suggestion. `op` is where the model runs (`cpu` or `gpu`); `load~s` is the
    estimated cold-load seconds, so a `cpu` model is expensive to switch to and a `gpu` model is
    cheap. `vision` marks the models that accept images. Columns are tab-separated.

    `qfn` is the frontier and the only model that needs no load: it never switches, and its slot
    count (5 on the resting profile) is the concurrency limit. Every other local model is refused
    on the resting profile — it needs a colo profile, which reloads the engine for everybody.

    ```
    ${llm.mkCatalog}
    ```

    Call `fleet-status` for what is loaded right now and the host headroom before you commit to a
    model that would force a load. Call `measure` on a large input before you delegate it.
  '';
  # `rules` takes either `types.lines` (a string) or an absolute path — not a derivation — so the
  # text is passed directly. It is a string here, which the option concatenates into the prompt.
  piRules = piRulesText;

  # pi-orchestrator's own config. In engaged mode it keeps ONLY `delegate` plus the tools named in
  # `keepTools`, so `measure` (the context gate) and `fleet-status` (live state) are reachable only
  # if listed here. Verified: without this file the parent sees `["delegate"]` and nothing else.
  #
  # The file is read from the FIRST of `cwd/.pi/extensions`, `$PI_CODING_AGENT_DIR/extensions`,
  # `$PI_CODING_AGENT_DIR`. Writing it into the repo (`.pi/`, git-ignored, generated by devenv) hits
  # the first path, so it travels with the checkout and needs no home-dir edit.
  orchestratorJsonc = builtins.toJSON {
    keepTools = [
      "delegate"
      "measure"
      "fleet-status"
      "ask_user"
      "session_list"
      "session_digest"
      "session_detail"
      "session_grep"
    ];
    # Children load the model-discovery extension: the planner/reviewer `model:` pins name
    # `litellm-dynamic` ids (the gateway's live catalog), which a spawned child cannot see
    # without it — the wrapper's --extension flags do not reach it, and pi's own discovery
    # finds nothing on disk. A non-empty list means the child runs --no-extensions plus this
    # one source, so it stays lean.
    childExtensions = [ (toString ext.model-discovery) ];
  };

  # The repository Pi configuration, shared by the normal wrapper and the ClankTalk launcher.
  # `mkCodingAgent` returns a wrapper that always passes `--append-system-prompt` and the
  # resource flags; the two callers differ only in the extension list.
  piAgent = {
    # The repo flake's version-selected package (local copy > pi.nix > nixpkgs), so devenv
    # gets the vendored 1.5.1. devenv's own `pkgs` has no repo overlay, so read the flake
    # output instead of `pkgs.pi-coding-agent`.
    package = inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.pi-coding-agent;
    # The default working style for local LLMs plus the model catalog, appended to every
    # session's system prompt. Built above as one file because `rules` takes a single path.
    rules = piRules;
    extensions = [
      ext.timestamps
      ext.idle-marker
      # Side conversations in a TUI overlay (`/btw`, `/side`, `/btw:*`), so a
      # tangent does not spend the main session's context. Needs a TUI; the
      # devshell is interactive, so it stays on by default.
      ext.pi-btw
      # Vendored pi-orchestrator: engaged by default, so the parent agent keeps only
      # `delegate` and all work goes to the subagent fleet. Replaces our ad-hoc
      # subagent extension, whose async/status/retry behaviour this one already has.
      ext.pi-orchestrator
      ext.orchestrator-gate
      # The engine profile, injected into the prompt once per profile change (see the package).
      ext.engine-state
      # Live fleet state (loaded aliases, served context, host headroom) so the
      # orchestrator can pick a model from intent AND cost, not a fixed tier.
      ext.fleet-status
      # Dynamic model discovery: registers litellm + llama-swap providers with
      # refreshModels, so `pi --list-models`/`/model` show the live catalog
      # (including server-side-discovered Requesty ids) above static models.json.
      ext.model-discovery
      # Status rail and live activity sidebar: model, context, usage, git status,
      # tool/agent activity and per-subagent cost. The Pi-harness status surface in
      # place of the OpenCode built-ins.
      ext.pi-atelier
      # `ask_user`: an agent can stop and ask the operator a focused question (option
      # lists, multi-select, freeform) instead of guessing or silently ending its turn.
      ext.pi-ask-user
      # `session_list` / `session_digest` / `session_detail`: read Pi sessions in widening
      # steps (list -> digest with #n refs -> exact detail) so an agent learns what a prior
      # session did without loading the whole file into context.
      ext.session-digest
      # Hashline read/edit: read emits [path#TAG] + N: lines; edit takes a line-anchored
      # patch and rejects a stale tag, so a small model cannot edit lines from an old read.
      ext.pi-hashline-edit
    ];
    skills = [
      # `pi-btw` ships `skills/btw/SKILL.md` beside `extensions/btw.ts`, and `--extension`
      # loads only the extension entry point. Without `--skill` the `/btw` commands still
      # register, but nothing teaches the model when to reach for them.
      "${ext.pi-btw}/skills"
    ];
  };

  piWrapped =
    (pi.lib.mkCodingAgent {
      inherit pkgs;
      modules = [ { pi.coding-agent = piAgent; } ];
    }).package;

  # ClankTalk is a mode, not the default: the launcher loads only the ClankTalk extension and
  # `model-discovery` (providers, not tools), and disables Pi's own discovery. The repository
  # wrapper cannot be reused as is, because it passes every extension with an explicit `-e`,
  # and explicit paths survive `--no-extensions`.
  clankPiWrapped =
    (pi.lib.mkCodingAgent {
      inherit pkgs;
      modules = [
        {
          pi.coding-agent = piAgent // {
            extensions = [
              "${clankTalk}/lib/clank-talk/src/js/harnesses/pi.js"
              ext.model-discovery
            ];
            skills = [ ];
            extraArgs = [ "--no-extensions" ];
          };
        }
      ];
    }).package;

  clankPi = pkgs.writeShellScriptBin "clank-pi" ''
    set -euo pipefail
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    export CLANK_TALK_ROOT="$root"
    exec ${clankPiWrapped}/bin/pi "$@"
  '';

  clankOpenCode = pkgs.writeShellScriptBin "clank-opencode" ''
    set -euo pipefail
    root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    export CLANK_TALK_ROOT="$root"
    export KDN_CLANK_TALK=1
    # The shim reads KDN_CLANK_TALK in the OpenCode server process. A private server keeps the
    # variable in the process that loads the plugin; the background service would not see it.
    exec opencode --standalone "$@"
  '';

  # The `jj fix` file set, derived from the one formatter registration in `treefmt.nix`. A list here
  # would be a second file set that drifts from the formatter: the hand-written list this replaces
  # missed `*.pyi`, `*.envrc` and `*.envrc.*`, which treefmt already formats. `treefmt --stdin`
  # applies the same exclude globs, so a generated `index.md` stays out of a fix too.
  #
  # The include globs come from the evaluated module, because most programs leave `includes` at the
  # treefmt-nix default. `treefmt-nix` is reached through the self input for the same reason
  # `inputs.nix-configs.packages` is: devenv gets its inputs from `devenv.yaml`, which does not
  # declare it.
  fixPatterns =
    let
      treefmt-nix = inputs.nix-configs.inputs.treefmt-nix.lib;
      settings = (treefmt-nix.evalModule pkgs (import ./treefmt.nix { })).config.settings;
      toJjGlob = include: "glob:'**/${include}'";
    in
    pkgs.lib.unique (
      builtins.concatMap (formatter: map toJjGlob formatter.includes) (
        builtins.attrValues settings.formatter
      )
    );
in
{
  imports = inputs.nix-configs.denLib.imports {
    class = "devenv";
    inherit aspects;
  };

  config = {
    # argc drives the subcommand dispatch in the zellij-llm/kdn-slug bash packages; keep it
    # on PATH so the standalone scripts run and get tested in the shell.
    packages = [
      pkgs.argc
      # This repo's own Nix maintenance tools: collect-garbage (bounded batches),
      # reap-builders (plan/apply for leaked daemon workers), list-roots, which, and
      # `kdn-tools` which lists this tooling. Same set the kdn-nix package installs.
      (pkgs.callPackage ./packages/kdn-nix { })
      # numtide/disko-zfs (this repo's pinned input) plus the kdn-disko-zfs wrapper
      # (spec/show/plan/apply for any host's disko-declared ZFS datasets).
      inputs.nix-configs.inputs.disko-zfs.packages.${pkgs.stdenv.hostPlatform.system}.default
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.kdn-disko-zfs
      # Browse docs/tasks and .cache/agents from the shell: summary, task list, boards,
      # worklogs, doctor and the TUI. See docs/kdn-journal.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.kdn-journal
      # Attribute a jj change to the agent session that produced it. The binary writes the
      # Assisted-by/Generated-by/Session-Id/Harness/Model trailers. See docs/kdn-jj-meta.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.kdn-jj-meta
      # Index and browse OKF v0.2 bundles: list, search, outline/section/context, links, doctor
      # and the TUI. See docs/kdn-okf.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.kdn-okf
      # Git-native agent memory on OKF v0.2. It owns .agents/knowledge; kdn-okf only reads it.
      # See docs/okf-memory.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okf-agent-memory
      # The AI-XF validator and canonicaliser. The memory bundle is checked at Level 2.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.ai-xf
      # Screen an external document for hidden content and prompt injection before its text
      # reaches .agents/knowledge. See docs/okf-guard.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okf-guard
      # The Rust OKF toolkit: strict conformance, lint, link graph and link-safe `mv`/`rm`.
      # See docs/okf-toolchain.md.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okf-rs
      # The per-type compliance linter and its manifest gate.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okflint
      # Git-native impact analysis: `affected --git`, `deps`, `dependents`.
      inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okph
      # Pi, wired from repo files so its config is versioned instead of living in ~/.pi:
      #   data/pi/models.json     the fleet models + context tiers (no secret; the key is a
      #                           runtime `!cat /run/configs/...` reference)
      #   data/pi/extensions/     timestamps, idle-marker (the agent roster lives in data/pi/agents/)
      #   data/pi/agents/         scout / worker / reviewer / planner / orchestrator
      # The wrapper appends --extension for each, so a plain `pi` in this shell has them.
      piWrapped
      # The opt-in ClankTalk launchers. `clank-pi` calls the real Pi binary with only the ClankTalk
      # extension (plus model-discovery); `clank-opencode` sets KDN_CLANK_TALK for the gated shim.
      clankPi
      clankOpenCode
      # The `hack/*.py` helpers, including the certificate-expiry summary the shell entry reads.
      pkgs.python3
    ]
    ++ pkgs.lib.optionals pkgs.stdenv.hostPlatform.isLinux [
      # ClankTalk's `in a sandbox` uses bubblewrap on Linux. The launchers are in this shell, so the
      # binary must be on PATH; without it, a sandboxed tool refuses to run. macOS uses sandbox-exec.
      pkgs.bubblewrap
    ];

    # Certificate expiry reminder. `hack/certs-expiry.py` decodes the certificates ONCE and
    # commits the result to `data/certs/expiry.json`; shell entry only loads that small JSON, so
    # nothing decodes a certificate on activation. Re-run the script to refresh it, and
    # `--check` fails when the committed summary is stale.
    enterShell = ''
      python3 hack/certs-expiry.py --remind || true
    '';

    # pi-orchestrator's config, generated so the engaged parent keeps `measure` and `fleet-status`
    # beside `delegate`. See `orchestratorJsonc` above for why it lives in `.pi/`.
    files.".pi/extensions/orchestrator.jsonc".text = orchestratorJsonc;

    # This repository authors the agent instruction files, so it asks for every one of
    # them. Each `installAgentRules` option defaults to false, so an adopter states its own
    # work mandate. `kdn.isSourceRepo = true` makes every one of these inert here, because
    # this repository commits the files itself. They stay as the explicit intent.
    kdn.isSourceRepo = true;
    kdn.nix.installAgentRules = true;
    kdn.jj.installAgentRules = true;
    kdn.zellij.installAgentRules = true;
    kdn.mcp.basic-memory.installAgentRules = true;
    # The writable memory bundle. Read tools are safe; write tools are reviewed before use.
    kdn.mcp.extraBackends.okf-memory = {
      description = "okf-memory";
      command = "${
        inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.okf-agent-memory
      }/bin/okf-memory mcp ${config.devenv.root}/.agents/knowledge";
    };

    # This repository's own formatter app. The aspect allow-lists no app name, so this line
    # keeps the Bash allow rule that the slot used to carry.
    kdn.nix.extraBashAllow = [ "nix run .#kdn-nix-fmt -- *" ];

    # This value belongs to this repository, not to the aspect. The aspect default is
    # neutral (`origin`), so this line keeps the behaviour.
    kdn.jj.upstream.remote = "kdn";

    # Format every language as jj snapshots the working copy. `jj fix` pipes each matching file
    # through the treefmt wrapper on every snapshot, so the tree stays formatted while you work
    # instead of only when you remember to run `nix fmt`.
    #
    # The command is the treefmt wrapper with ONE config, `packages.treefmt-config`, built from
    # `treefmt.nix`. A per-tool list here would be a second source of truth that drifts from
    # `treefmt.nix`; the wrapper reads the same generated `treefmt.toml` that `nix fmt` reads, so
    # there is nothing to keep in step.
    #
    # `treefmt --stdin` picks the formatter by the path's extension, which is why `$path` is passed
    # as an argument. The config's commands are `/nix/store/...` paths from the same build that
    # produces this symlink, so they are valid for as long as the shell lives.
    #
    # `revsets.fix` defaults to `reachable(@, mutable())`, so a fix also reaches mutable ancestors.
    # That is jj's default and it is what makes the feature useful: a forgotten table gets aligned
    # when a descendant changes it.
    #
    # `patterns` comes from `fixPatterns` above, which reads the include globs out of `treefmt.nix`.
    # It is not a second file set: the same file that names each tool also names the extensions the
    # tool claims.
    kdn.jj.config.fix.tools.treefmt = {
      # The wrapper already carries its own `--config-file`; `--stdin $path` makes it read this
      # file's content from stdin and pick the formatter by the extension of `$path`. jj passes the
      # content on stdin and substitutes `$path` in the command.
      command = [
        "${inputs.nix-configs.packages.${pkgs.stdenv.hostPlatform.system}.treefmt-wrapper}/bin/treefmt"
        # `--quiet` is required, not cosmetic: without it the wrapper prints its progress log on
        # stdout beside the formatted file, and `jj fix` takes the WHOLE stdout as the new content.
        "--quiet"
        "--stdin"
        "$path"
      ];
      patterns = fixPatterns;
    };

    # `mcp-servers-nix` is a `devenv.yaml` input, so the aspect cannot reach it. The shell
    # passes it here; without it every `kdn.mcp.programs` entry stays inert.
    kdn.mcp.serversNix = inputs.mcp-servers-nix;

    # This repository's own knowledge root. The aspect default names no repository.
    kdn.mcp.basic-memory.knowledgeRoot = "$HOME/.local/share/kdn-nix-configs/knowledge";
    # The aspect names no base. These two entries keep the backends and the note paths.
    kdn.mcp.basic-memory.bases.public = {
      aliases = [ "bmp" ];
      description = "basic-memory public knowledge base (open-source tooling, public knowledge)";
    };
    kdn.mcp.basic-memory.bases.sensitive = {
      aliases = [ "bms" ];
      description = "basic-memory sensitive knowledge base (private, internal)";
    };

    # In-devenv opencode capability: a project `opencode.jsonc` and an `opencode` wrapper
    # (key/svc auth) on PATH. The brys-specific model/proxy wiring lives in the
    # hostname-gated profile below.
    #
    # These values belong to this repository, not to the aspect. The aspect defaults are
    # neutral (an empty provider set, the store path only, and no credential). The Requesty
    # cloud provider is enabled but hardcodes no model; the local fleet provider is added by
    # the hostname-gated profiles below.
    kdn.opencode.settings.provider.requesty = { };
    kdn.opencode.allowedPaths = [
      "/nix/store/**"
      "~/dev/**"
    ];
    kdn.opencode.authKeys.REQUESTY_API_KEY = "requesty";
    # The ClankTalk OpenCode shim. Every session loads it, but it does nothing unless
    # `clank-opencode` sets KDN_CLANK_TALK=1. See docs/clank-talk.md.
    kdn.opencode.clankTalk = {
      enable = true;
      package = clankTalk;
    };

    # brys-specific profile: feeds the requesty provider config and the requesty
    # DSML proxy (:9526). Auto-activated only on a host whose hostname is
    # "brys"; every other host keeps the benign global opencode skeleton.
    profiles.hostname."brys".module = import ./hosts-den/brys/devenv.nix;

    # oams-specific profile: opencode pointed at the etra LiteLLM gateway plus
    # oams' own local llama-swap loopback. Auto-activated only on a host whose
    # hostname is "oams".
    profiles.hostname."oams".module = import ./hosts/oams/devenv.nix;
  };
}
