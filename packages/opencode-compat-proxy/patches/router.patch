 # when unset the streaming path keeps the original no-auth behaviour.
 FORWARD_AUTHORIZATION = os.environ.get("FORWARD_AUTHORIZATION", "").lower() in ("1", "true", "yes")
 
+# Model-based routing across two llama-server routers. The frontier router
+# (default $UPSTREAM_URL) always exists; $SMALL_UPSTREAM_URL optionally adds a
+# second "small" router that swaps among the freely-swapping small-set models.
+# When $SMALL_UPSTREAM_URL is unset, routing is OFF and every request goes to
+# UPSTREAM exactly as before (single-router backward compatibility).
+SMALL_UPSTREAM_URL = os.environ.get("SMALL_UPSTREAM_URL")
+UPSTREAMS = {"frontier": UPSTREAM}
+# {model-or-alias: "small"} membership table, configurable via a comma-separated
+# $SMALL_MODELS list (defaults to the design's small-set aliases). Anything not
+# in the table routes to the frontier/UPSTREAM router.
+ROUTE = {}
+if SMALL_UPSTREAM_URL:
+    UPSTREAMS["small"] = SMALL_UPSTREAM_URL
+    for m in (x.strip() for x in os.environ.get("SMALL_MODELS", "phi-4,qwen3-30b-a3b,fast").split(",")):
+        if m:
+            ROUTE[m] = "small"
+
+
+def upstream_for(model):
+    """Return the base URL for a model: the small router when it is a small-set
+    member and that router is configured, otherwise UPSTREAM (frontier)."""
+    if SMALL_UPSTREAM_URL and ROUTE.get(model) == "small":
+        return UPSTREAMS["small"]
+    return UPSTREAM
+
