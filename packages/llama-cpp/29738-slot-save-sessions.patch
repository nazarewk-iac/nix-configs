+            if (!save_slot_draft(filepath, slot, nwrite_dft)) {
+                if (err_msg) {
+                    *err_msg = "Unable to save slot: incomplete draft state";
+                }
+                t_ms = (ggml_time_us() - t_start) / 1000.0;
+                return 0;
+            }
+            nwrite += nwrite_dft;
+        }
+
+        t_ms = (ggml_time_us() - t_start) / 1000.0;
+
+        return nwrite;
+    }
