+    // the slot for a session-tagged task: the slot already holding the session, else an idle
+    // slot with the session state restored from disk; -1 when no slot is free
+    // the prompt cache is bypassed, the session file carries the state
+    int select_session_slot(const server_task & task) {
+        const std::string & session_id = task.session_id;
+
+        // reuse the slot already holding this session
+        for (auto & slot : slots) {
+            if (slot.is_processing()) {
+                continue;
+            }
+            if (slot.session_id != session_id) {
+                continue;
+            }
+            if (task.id_slot != -1 && slot.id != task.id_slot) {
+                continue; // explicit pin takes priority
+            }
+
+            auto it = sessions.find(session_id);
+            if (it != sessions.end()) {
+                it->second.t_last = ggml_time_us();
+            }
+
+            SLT_INF(slot, "selected slot by session id (%s)\n", session_id.c_str());
+            return slot.id;
+        }
+
+        // no in-memory match, take an idle victim and restore the session if possible
+        server_slot * victim = nullptr;
+
+        if (task.id_slot != -1) {
+            server_slot * requested = get_slot_by_id(task.id_slot);
+            if (requested != nullptr && !requested->is_processing()) {
+                victim = requested;
+            }
+        } else {
+            // the slot that loses the least by being reused: empty first, then the least recently used
+            const std::vector<int> free_slots = slot_sched.get_free_slots(get_slot_infos(), 1, -1);
+            if (!free_slots.empty()) {
+                victim = get_slot_by_id(free_slots.front());
+            }
+        }
+
+        if (victim == nullptr) {
+            return -1; // no idle slot, the task is deferred
+        }
+
+        evict_slot_session(*victim);
+
+        const std::string filepath = params_base.slot_save_path.empty()
+            ? std::string()
+            : session_filepath(session_id);
+
+        if (!filepath.empty() && fs::exists(filepath)) {
+            double t_ms = 0.0;
+            std::string err_msg;
+            if (slot_restore_from_file(*victim, filepath, t_ms, &err_msg) > 0) {
+                SLT_INF(*victim, "restored session %s from %s (%.2f ms)\n", session_id.c_str(), filepath.c_str(), t_ms);
+            } else {
+                SLT_WRN(*victim, "failed to restore session %s from %s, starting fresh\n", session_id.c_str(), filepath.c_str());
+            }
+        }
+
+        stamp_slot_session(*victim, session_id);
+
+        return victim->id;
+    }
