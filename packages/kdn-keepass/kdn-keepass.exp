#!/usr/bin/env expect

proc log {logger message} {
  send_user -- "$logger: $message\n"
}

lassign $argv dbpath passpath

# Fetch the password BEFORE spawning KeePassXC. `pass` decrypts through gpg, which needs the
# YubiKey; right after a cold boot the card and the agent are not ready yet, and the old order
# spawned KeePassXC first and then died in `exec pass`, leaving an orphan with no password — the
# database opened "locked" and systemd saw a healthy unit, so nothing retried. Retry here with a
# bound, and fail before the spawn so `Restart=on-failure` reruns the whole unit.
set password ""
set got_password 0
for {set attempt 1} {$attempt <= 20} {incr attempt} {
  if {[catch {exec pass $passpath 2>/dev/null} out] == 0 && [string trim $out] ne ""} {
    set password $out
    set got_password 1
    break
  }
  log kdn-keepassxc "pass failed (attempt $attempt of 20); retrying"
  after 1500
}
if {!$got_password} {
  log kdn-keepassxc "no password from pass after 20 attempts; not starting KeePassXC"
  exit 1
}

spawn keepassxc --pw-stdin "$dbpath"
set keepassxc_spawn_id $spawn_id
set keepassxc_pid [exp_pid]
log kdn-keepassxc "started as PID=$keepassxc_pid SPAWN_ID=$spawn_id"

if {[info exists ::env(NOTIFY_SOCKET)]} {
  system systemd-notify --pid="$keepassxc_pid"
  log kdn-keepassxc:systemd "MAINPID set to $keepassxc_pid"
}

expect {
  "Another instance of KeePassXC is already running." { exit 1 }
  "Database password: " {
    send "$password\n"
    send_user "\n"
    log kdn-keepassxc "password submitted"
  }
  timeout { exit 1 }
}
log kdn-keepassxc "wait to be ready"

# Ready means: an UNLOCKED database, not "some KeePassXC window exists".
# A half-loaded KeePassXC shows an "Unlock Database" modal whenever a Secret Service search
# arrives during the load (upstream keepassxc PR #13321); the console password never takes
# effect and the instance waits for a human forever. Matching the first window by app_id
# accepted that dialog as success and lied to systemd (measured on oams, cold boot
# 2026-11-14: two SIGSEGV attempts plus a wedged dialog attempt).
# Poll the sway tree until keepassxc has a window and the "Unlock Database" dialog is gone.
# If it never unlocks, exit 1 so `Restart=on-failure` retries with a warmer YubiKey and a
# quieter D-Bus; the timeout is generous because a cold Argon2id load with a hardware-key
# challenge can take most of a minute.
if {[info exists ::env(SWAYSOCK)]} {
  # KEEPASS_UNLOCK_DEADLINE_SECONDS is a test knob; the unit never sets it (default 120).
  set deadline_seconds 120
  if {[info exists ::env(KEEPASS_UNLOCK_DEADLINE_SECONDS)]} {
    set deadline_seconds $::env(KEEPASS_UNLOCK_DEADLINE_SECONDS)
  }
  set unlock_deadline [expr {[clock seconds] + $deadline_seconds}]
  while {1} {
    expect {
      -i $keepassxc_spawn_id
      -timeout 2
      eof {
        log kdn-keepassxc "keepassxc exited before unlocking"
        exit 1
      }
    }
    if {![catch {exec swaymsg -t get_tree} tree]} {
      if {[string match {*org.keepassxc.KeePassXC*} $tree]
        && ![string match {*Unlock Database - KeePassXC*} $tree]} {
        log sway {"org.keepassxc.KeePassXC" database unlocked}
        break
      }
    }
    if {[clock seconds] > $unlock_deadline} {
      log kdn-keepassxc "not unlocked after ${deadline_seconds}s; killing PID=$keepassxc_pid for a unit restart"
      # The wedged instance ignores SIGTERM (measured on oams 2026-11-14: TERM was swallowed
      # while the modal dialog loop ran, and the unit stayed "active" with the locked instance).
      # Wait for the pty to close; escalate to SIGKILL so MainPID really dies and
      # `Restart=on-failure` fires.
      catch {exec kill $keepassxc_pid}
      expect {
        -i $keepassxc_spawn_id
        -timeout 10
        eof {}
        timeout {
          log kdn-keepassxc "SIGTERM ignored; escalating to SIGKILL"
          catch {exec kill -9 $keepassxc_pid}
        }
      }
      exit 1
    }
  }
}
if {[info exists ::env(NOTIFY_SOCKET)]} {
  system systemd-notify --ready
  log kdn-keepassxc:systemd "ready signal sent"
}

# Keep the pty open until KeePassXC exits. `interact` reads from the wrapper's own stdin, and a
# system service has none, so it returns at once: expect then exits, closes the pty mid-unlock, and
# KeePassXC falls back to its "Unlock Database" dialog even though the password was submitted
# (measured on oams, 2026-11-10). `expect eof` blocks on the child instead and needs no TTY.
expect -i $keepassxc_spawn_id eof
