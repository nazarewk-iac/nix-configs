# The repository formatter, and the ONLY place that names a formatting tool, its options, its file
# globs and its excludes. Three consumers read this one file, so they cannot disagree:
#
#   * `nix fmt` and `nix flake check` — `flake.nix` loads this file as the treefmt-nix module;
#   * `jj fix` — `devenv.nix` runs `packages.treefmt-wrapper` with the generated `treefmt.toml`;
#   * `checks.<system>.markdown-format` — `checks/default.nix` evaluates this module and reads
#     `settings.formatter.prettier` (command, options, includes) and `settings.excludes`.
#
# A check imports these values; it never restates them. `markdown-format` is the pattern to copy: it
# runs the prettier command named here, with the options named here, over the file set that
# `includes` and `excludes` describe. A rule or a skill names the command `nix fmt`, never a flag.
#
# ## Why treefmt
#
# The tree is six languages, and each needs its own tool. treefmt runs one program per file type and
# exposes a single `formatter.${system}` output, so one command covers everything without a shell
# script of `fd` + `xargs`. It also guards the seams: a file matches at most one formatter, so two
# tools never fight over the same bytes.
#
# ## One tool per language
#
# | Language | Tool          | Why this one                                                  |
# | -------- | ------------- | ------------------------------------------------------------- |
# | Nix      | nixfmt        | The tree is already nixfmt-clean; `kdn-nix-fmt` calls it too.  |
# | Markdown | prettier      | Pads table cells so the pipes line up for a terminal reader.  |
# | Python   | ruff format   | The tree is already ruff-formatted. A formatter, not a linter. |
# | Go       | gofumpt       | A stricter gofmt; the tree is already gofumpt-clean.          |
# | Shell    | shfmt         | Two-space indent, no `simplify`; matches the existing style.  |
# | TOML     | taplo         | Sorts nothing by default; only normalises layout.             |
# | JSON     | prettier      | Same tool as Markdown; JSON is a prettier preset.             |
# | YAML     | yamlfmt       | Keeps block style; does not fold long strings.                |
#
# `ruff-format` is the formatter half of ruff. The linter half (`ruff check`) is not run here: a
# formatter must not change meaning, and a lint fix can. For the same reason shellcheck is a linter
# and not a treefmt program. See docs/formatter-convergence.md for the full inventory.
{ ... }:
{
  projectRootFile = "flake.nix";

  programs = {
    nixfmt.enable = true;

    prettier = {
      enable = true;
      includes = [
        "*.md"
        "*.mdx"
        "*.json"
      ];
      settings = {
        proseWrap = "preserve"; # keep the author's line breaks in prose
        printWidth = 100;
      };
    };

    ruff-format.enable = true;

    # `gofumpt` and not `gofmt`: it is gofmt plus a few stricter rules, and the Go files here are
    # already gofumpt-clean. It is a superset, so a gofmt-clean file stays clean.
    gofumpt.enable = true;

    # Two-space indent, no `-s`: `simplify` can rewrite a construct that the author wrote on
    # purpose, and the formatter must not change meaning.
    shfmt = {
      enable = true;
      indent_size = 2;
      simplify = false;
    };

    # taplo sorts nothing unless told to, so `taplo format` only normalises layout. Key order is
    # part of a file's meaning here (a flake input block reads top to bottom), so no sorting.
    taplo.enable = true;

    yamlfmt.enable = true;
  };

  # Do not format files that are generated, vendored, or whose layout carries meaning. treefmt
  # applies this list to every program, so it is also the file set that `markdown-format` gates:
  # one list, not two.
  settings.excludes = [
    # Lock files are machine-written; a reformat is churn with no reader.
    "*.lock"
    "*.lock.md"
    "devenv.lock"
    "flake.lock"
    "package-lock.json"
    "go.sum"

    # A SOPS file carries an encrypted `sops:` block whose layout is part of the ciphertext
    # envelope. Reformatting it breaks decryption.
    "*.sops.yaml"

    # The unattended-install secret mirrors its own SOPS layout for the same reason.
    "default.unattended.sops.yaml"

    # A generated directory listing. `kdn-okf generate-index` and `okf-agent-memory` own every
    # `index.md` in this tree: 216 of the 219 tracked ones carry `generated: true` in frontmatter,
    # and the other three are generated by another tool or are a test fixture. The generator writes
    # a trailing blank line that prettier removes, so formatting one of these files makes the next
    # regeneration flip it back. The generator owns the layout; prettier stays out.
    #
    # The top-level file needs its own entry: treefmt matches `**/index.md` with doublestar, where
    # `**/` needs at least one directory. `**/index.md` alone would leave the root index formatted.
    "index.md"
    "**/index.md"

    # This template is copied verbatim by `init-py-script`. Its placeholders and its layout are the
    # product, so a formatter must not touch it.
    "packages/init-py-script/template/**"

    # A fixture bundle for `kdn-okf-parse`. It is input to a parser test, not a document, so its
    # bytes stay as the test wrote them.
    "checks/kdn-okf/bundle/**"

    # Generated build inputs and tool state.
    "node_modules/**"
    ".devenv/**"
    ".jj/**"

    # In-flight work that another track owns. Each entry is currently unformatted, so the Markdown
    # gate would report it, and formatting it would fight that track. Delete an entry as soon as its
    # track lands, and format the file then. These are the only sanctioned gaps between `nix fmt`
    # and the gate; `checks/default.nix` holds no list of its own.
    "docs/local-llms.md"
    "docs/tasks/2026-11/brys-r9700-model-fit/**"
    "docs/tasks/2026-11/router-wan-shaping/etra.md"
    "hosts-den/brys/performance.md"
  ];
}
