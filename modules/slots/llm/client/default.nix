# LAN LLM client slot.
#
# Adds opencode providers for one or more LAN llama-servers exposed over HTTPS
# (see the sibling `kdn.llm.local` server slot). Each upstream is keyed by
# name in `kdn.llm.client.upstreams.<name>` and the slot writes a
# `provider.<name>` into opencode's settings (baseURL, apiKey {env:...},
# models). Key injection is delegated to the single `opencode` wrapper via
# `kdn.opencode.wrapper.envFiles`, and self-signed CA trust is handled
# system-wide (security.pki).
#
# It does NOT enable opencode itself — the consumer enables `kdn.opencode`
# (which turns opencode on and supplies the default permission skeleton and the
# `opencode` wrapper). This slot only adds `provider.<name>` settings.
#
# The consumer is a thin passthrough: it only supplies, per upstream, the
# required info (baseURL, caCertFile, apiKeyFile, models).
#
# This slot is STANDALONE. It must not reference or assign any option declared
# by modules/universal/ or modules/meta/. It uses only `lib`, `pkgs`, `config`,
# and plain devenv options (opencode.settings, packages). See
# .agents/rules/slots-standalone.md.
{
  lib,
  pkgs,
  config,
  ...
}:
let
  cfg = config.kdn.llm.client;

  enabledUpstreams = lib.filterAttrs (_: u: u.enable) cfg.upstreams;

  # The opencode provider ids of the enabled LAN upstreams. The session plugin
  # injects `x-session-id` only for these, so a commercial upstream never sees
  # the header.
  providerIds = map (u: u.name) (lib.attrValues enabledUpstreams);

  # An opencode plugin that tags every request to a LAN llama-server with the
  # opencode session id as `x-session-id`. llama-server's session-keyed
  # save/restore (llama.cpp PR #29738) reads that header and persists/resumes
  # the conversation's KV state on disk. Written into `.opencode/plugins/` by
  # devenv, so opencode running in a consumer project auto-loads it.
  sessionPlugin = ''
    import type { Plugin } from "@opencode-ai/plugin"

    // Generated by kdn.llm.client. The header names the LAN llama-server
    // session (see --slot-save-sessions on the server).
    const PROVIDERS = new Set(${builtins.toJSON providerIds})

    export const KdnLlmSessionId: Plugin = async () => {
      return {
        "chat.headers": async (input, output) => {
          if (PROVIDERS.has(input.provider.info.id)) {
            output.headers["x-session-id"] = input.sessionID
          }
        },
      }
    }

    export default KdnLlmSessionId
  '';

  # Build one provider entry for an upstream.
  toProvider = _: u: {
    provider.${u.name} = {
      npm = "@ai-sdk/openai-compatible";
      name = u.displayName;
      options = {
        baseURL = u.baseURL;
        apiKey = "{env:KDN_LLM_API_KEY_${u.name}}";
      };
      models = lib.mapAttrs (
        _: m:
        {
          name = m.name;
          limit.context = m.context;
          limit.output = m.output;
        }
        // lib.optionalAttrs m.reasoning { reasoning = true; }
        // lib.optionalAttrs (m.options != { }) { inherit (m) options; }
      ) u.models;
    };
  };
in
{
  options.kdn.llm.client = {
    enable = lib.mkEnableOption "LAN LLM client (opencode pointed at HTTPS llama-servers)";

    upstreams = lib.mkOption {
      type = lib.types.attrsOf (
        lib.types.submodule (
          { name, ... }: {
            options = {
              enable = lib.mkEnableOption "this upstream in opencode";

              # Canonical provider key; defaults to the attr name so a
              # consumer writes `upstreams.moss` and gets `provider.moss`,
              # but can still override.
              name = lib.mkOption {
                type = lib.types.str;
                default = name;
                description = "Provider/wrapper key for this upstream.";
              };

              displayName = lib.mkOption {
                type = lib.types.str;
                default = name;
                description = "Human-readable provider name shown in opencode.";
              };

              baseURL = lib.mkOption {
                type = lib.types.str;
                example = "https://llm.example.invalid/v1";
                description = "Base URL of the LAN llama-server (through its TLS proxy).";
              };

              # Trusted CA certificate (informational for the consumer). null => opencode
              # trusts the system store only; with a self-signed endpoint, the host wires
              # this via security.pki.certificateFiles (system-wide) instead.
              caCertFile = lib.mkOption {
                type = lib.types.nullOr lib.types.path;
                default = null;
                description = ''
                  Path to the self-signed PEM public certificate of the endpoint.
                  Informational: the consumer trusts it system-wide via
                  security.pki.certificateFiles (self-signed CA is not injected
                  per-upstream). null means the endpoint uses a publicly-trusted
                  cert chain.
                '';
              };

              # API key. The consumer injects it into opencode via
              # kdn.opencode.envFile. null => the endpoint needs no key.
              apiKeyFile = lib.mkOption {
                type = lib.types.nullOr lib.types.path;
                default = null;
                description = ''
                  Path to a file holding the API key (one line). The provider uses
                  apiKey {env:KDN_LLM_API_KEY_<name>}; the consumer loads this file
                  into that var via kdn.opencode.envFile. null means the endpoint
                  needs no key.
                '';
              };

              models = lib.mkOption {
                type = lib.types.attrsOf (
                  lib.types.submodule (
                    { ... }: {
                      options.name = lib.mkOption {
                        type = lib.types.str;
                        description = "Human-readable model name shown in opencode.";
                      };
                      options.context = lib.mkOption {
                        type = lib.types.int;
                        default = 65536;
                        description = "Context window limit for opencode.";
                      };
                      options.output = lib.mkOption {
                        type = lib.types.int;
                        default = 8192;
                        description = "Output token limit for opencode.";
                      };
                      options.reasoning = lib.mkOption {
                        type = lib.types.bool;
                        default = false;
                        description = ''
                          Mark this model as reasoning-capable in opencode, so it parses the
                          model's thinking output. It does not by itself turn thinking on; set
                          `options` for that.
                        '';
                      };
                      options.options = lib.mkOption {
                        type = lib.types.attrsOf lib.types.anything;
                        default = { };
                        description = ''
                          Extra request-body fields that opencode sends verbatim for this model.
                          opencode merges them into the chat-completions body, so they reach
                          llama-server. Use it to turn on server-side thinking, for example
                          `{ chat_template_kwargs = { enable_thinking = true; }; }`.
                        '';
                      };
                    }
                  )
                );
                default = { };
                description = "Models exposed by this LAN endpoint, as opencode provider entries.";
              };
            };
          }
        )
      );
      default = { };
      description = "Upstream LAN llama-servers to expose as opencode providers, keyed by name.";
    };
  };

  config = lib.mkIf cfg.enable {
    devenv = {
      # Merge provider.<name> for every enabled upstream into opencode's
      # settings. The consumer must enable `kdn.opencode` (which turns
      # opencode on and supplies the `opencode` wrapper); this slot does not
      # enable opencode itself nor ship per-upstream wrappers — key injection for each
      # upstream is done via kdn.opencode.wrapper.envFiles.
      opencode.settings = lib.mkMerge (lib.mapAttrsToList toProvider enabledUpstreams);

      # The session-id plugin for the LAN upstreams. Written into the project's
      # `.opencode/plugins/`, which opencode auto-loads.
      files = lib.mkIf (enabledUpstreams != { }) {
        ".opencode/plugins/kdn-llm-session-id.ts".text = sessionPlugin;
      };
    };
  };
}
