###
### START ignore everything
###
# ignore everything by default
*
# do not ignore directories (still ignores their content)
!*/
# still ignore directiories with a leading dot
.*/
# do not ignore .gitignore files
!.gitignore
!.gitattributes
###
### END ignore everything
###

# shareable Jetbrains files
!.idea/modules.xml
!.idea/watcherTasks.xml
!.idea/vcs.xml
!.idea/misc.xml
!*.iml

!*.sops.yaml
!*.unattended.sops.*
.*.sops.yaml
!*.nix
.*.nix
!*.patch
.*.patch
!*.sh
.*.sh
!*.md
.*.md
!*.py
.*.py
!/.envrc
!/flake.lock
!/devenv.yaml
!/devenv.lock
# the adopter template ships a devenv.yaml, and `*.yaml` is not allowlisted
!/templates/adopter/devenv.yaml
!/templates/adopter-den/devenv.yaml
# machine-local slot settings — never tracked (see the note in devenv.nix)
/devenv.slots.local.nix

!/.flake.patches/
# den aspect data files with no extension. A den aspect reads a payload file next to itself, and
# the name drops the leading dot on purpose: a real `.gitignore` inside the aspect tree would hide
# a source file from the `git+file:` fetcher. `*` above ignores an extensionless name, so each one
# needs a line here.
!/modules/den/aspects/*/gitignore
!/modules/den/aspects/*/tool-versions
!/modules/den/aspects/*/wofi-config
# den aspect payload files with an extension that has no global allow line. `*` above ignores every
# `.json` and every `.toml`. A narrow pattern keeps every other `.json` and `.toml` ignored.
!/modules/den/aspects/*/*.json
!/modules/den/aspects/*/*.toml
!/modules/shared/universal/profile/user/kdn/
!/LICENSE

!/AGENTS.md
!/CLAUDE.md
!/.agents/
!/.claude

# KDN private CA material (data/ca/) and per-host certs (hosts/*/certs/)
!/data/ca/ca.pub
!/data/ca/ca.key.sops
!/hosts/*/certs/*.pub
!/hosts/*/certs/*.key.sops

# devenv-managed symlinks into /nix/store — never commit these
/.agents/rules/basic-memory*.md
/.agents/rules/flake-update.fork.md
/.agents/skills/
!/.agents/skills/*/SKILL.md

# ignore any tmp files
*.tmp*

# zellij-llm writes run markers under <repo>/.cache/zellij-llm/
/.cache/
