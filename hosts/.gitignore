###
### START ignore everything
###
# ignore everything by default
*
# do not ignore directories (still ignores their content)
!*/
# still ignore directiories with a leading dot
.*/
# do not ignore .gitignore files
!.gitignore
!.gitattributes
###
### END ignore everything
###

!*.nix
!meta.json
!*.md
.*.md
# SOPS-encrypted links
!/*/ssh-keys/ssh_host_*_key.{sops,pub}
!/*/luks/*.sops.header

# per-host certs (e.g. brys LLM leaf)
!/*/certs/*.pub
!/*/certs/*.key.sops

# per-host aura LED configs (e.g. oams G513QY suspend animation)
!/*/aura_*.ron

# per-host sops secrets (host-specific, e.g. hosts/oams/secrets.sops.yaml)
!/*/*.sops.yaml

# per-host service config files (e.g. hosts/etra/litellm.config.yaml)
!/*/*.config.yaml
