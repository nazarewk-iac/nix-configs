###
### START ignore everything
###
# ignore everything by default
*
# do not ignore directories (still ignores their content)
!*/
# still ignore directiories with a leading dot
.*/
# do not ignore .gitignore files
!.gitignore
!.gitattributes
###
### END ignore everything
###

!*.nix
!*.md
.*.md
# Per-host helper scripts (e.g. hosts/etra/litellm_auth.py, the LiteLLM custom-auth hook).
!/*/*.py
# SOPS-encrypted links
# SSH host keys, in both the OpenSSH-style name (`ssh_host_ed25519_key.sops`) and the repo's
# `<keyFile>.sops` form (`ssh_host_ed25519.key.sops`, see `keyDirectory`). Two lines, not one:
# .gitignore has no brace expansion, so `*.{sops,pub}` matches nothing.
!/*/ssh-keys/ssh_host_*.sops
!/*/ssh-keys/ssh_host_*.pub
!/*/luks/*.sops.header

# per-host certs (e.g. brys LLM leaf)
!/*/certs/*.pub
!/*/certs/*.key.sops

# per-host aura LED configs (e.g. oams G513QY suspend animation)
!/*/aura_*.ron

# per-host sops secrets (host-specific, e.g. hosts/oams/secrets.sops.yaml)
!/*/*.sops.yaml

# per-host service config files (e.g. hosts/etra/litellm.config.yaml)
!/*/*.config.yaml
