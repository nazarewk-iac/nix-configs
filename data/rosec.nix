# The rosec provider settings shared by every host that runs the Secret Service.
#
# The values live in the **Home Manager** scope because the daemon and the rendered
# `~/.config/rosec/config.toml` are user-level: the provider is enabled by `kdn.services.rosec.*`
# in the user configuration, not by a NixOS service. brys (den aspect) and oams (universal module)
# import this file, so the store path, identity and recipient cannot drift between them.
#
# Host-specific switches stay in the host: `use` (den) / `enable` (universal) for the daemon, and
# `conflictNotification` for the desktop integration.
{ ... }:
{
  kdn.services.rosec = {
    providers.sops = {
      # The store is a file tree under Nextcloud. It is copied from oams while the nextcloud
      # client is logged out; `docs/tasks/2026-11/secrets-sync-folder/` plans the Syncthing folder
      # that removes that dependency.
      path = "~/Nextcloud/drag0nius@nc.nazarewk.pw/important/rosec-storage";
      # Generated by `rosec-keys.service` from `age-plugin-yubikey --identity --slot 3`, the same
      # generator the sops-nix setup uses. The service runs at login and after a key swap, so the
      # key plugged into the machine is discovered without a hand-written file.
      key_file = "~/.config/sops/age/rosec-keys.txt";
      keyGeneration.enable = true;
      # The store is `derived`: this sops-encrypted master holds the derived identity, wrapped to
      # both the oams and brys unattended YubiKeys. One unwrap per session; item reads then cost
      # no YubiKey operation.
      identity_file = "~/Nextcloud/drag0nius@nc.nazarewk.pw/important/rosec-storage/.rosec-store-identity.sops.yaml";
      # The derived public key printed by `rosec-sops identity init`; every item file is encrypted
      # to it. The master above is the only file wrapped to the YubiKeys.
      age_recipient = "age1v4y8577rs8374lu4lfw7sgpq9mu8acd0q0zel4aygtfsvcj7zy3sdmy6e9";
    };
    ssh_fuse = false;
  };
}
